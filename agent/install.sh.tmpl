#!/bin/bash
# Personal Dash agent installer. Generated by the dashboard for one server.
# Usage: curl -fsSL "{{URL}}/api/agent/install?token={{TOKEN}}" | sudo bash
set -euo pipefail

DASH_URL="{{URL}}"
TOKEN="{{TOKEN}}"
DIR=/opt/dash-agent
CONF_DIR=/etc/dash-agent

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 is required (apt install python3)"; exit 1
fi

mkdir -p "$DIR" "$CONF_DIR/scripts"
curl -fsSL "$DASH_URL/api/agent/script" -o "$DIR/dash_agent.py"
chmod 755 "$DIR/dash_agent.py"

if [ ! -f "$CONF_DIR/config.json" ]; then
  cat > "$CONF_DIR/config.json" <<CONF
{
  "url": "$DASH_URL",
  "token": "$TOKEN",
  "interval": 20,
  "disks": ["/"],
  "discover_docker": true,
  "discover_failed_units": true,
  "services": [
  ]
}
CONF
  chmod 600 "$CONF_DIR/config.json"
  echo "Created $CONF_DIR/config.json — add your services there (systemd units, docker containers, paths)."
else
  echo "Keeping existing $CONF_DIR/config.json"
fi

cat > /etc/systemd/system/dash-agent.service <<UNIT
[Unit]
Description=Personal Dash agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 $DIR/dash_agent.py
Restart=always
RestartSec=10
Environment=DASH_AGENT_CONFIG=$CONF_DIR/config.json

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now dash-agent
sleep 2
systemctl --no-pager --lines=5 status dash-agent || true
echo
echo "dash-agent installed. Edit $CONF_DIR/config.json to list services; the agent reloads it on every report."
