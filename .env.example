# ---------- general ----------
# публичный домен (нужен для HTTPS, Telegram webhook, Web Push)
APP_DOMAIN=dash.example.com
# подпись JWT
APP_SECRET=change-me-long-random-string
# пароль входа в дашборд (один пользователь)
DASH_PASSWORD=change-me
TZ=Europe/Moscow

# ---------- database ----------
POSTGRES_USER=dash
POSTGRES_PASSWORD=dash
POSTGRES_DB=dash
DATABASE_URL=postgresql+asyncpg://dash:dash@db:5432/dash

# ---------- web push (VAPID) ----------
# сгенерировать: docker compose run --rm backend python -m app.tools.vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-random
# ваш числовой Telegram user id — только он управляет ботом
TELEGRAM_OWNER_ID=

# ---------- LLM для саммари и предложений задач ----------
# По умолчанию Claude. Чтобы подключить другую нейронку, задайте LLM_PROVIDER и LLM_API_KEY:
#   kimi       -> api.moonshot.ai   (Moonshot / Kimi K2)
#   deepseek   -> api.deepseek.com
#   openrouter -> openrouter.ai     (сотни моделей по одному ключу, LLM_MODEL=moonshotai/kimi-k2)
#   openai     -> api.openai.com
#   polza      -> polza.ai            (оплата в рублях, модели вендор/модель: LLM_MODEL=anthropic/claude-sonnet-5.5)
#   qwen       -> dashscope.aliyuncs.com
#   ollama     -> локальная модель без ключа (LLM_BASE_URL=http://host:11434/v1)
#   custom     -> любой OpenAI-совместимый endpoint: LLM_BASE_URL + LLM_MODEL
LLM_PROVIDER=anthropic
# ключ выбранного провайдера (для anthropic не нужен, см. ниже)
LLM_API_KEY=
# пусто = модель по умолчанию для провайдера
LLM_MODEL=
# пусто = адрес по умолчанию для провайдера
LLM_BASE_URL=

# для LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---------- google calendar ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# redirect uri в Google Console: https://${APP_DOMAIN}/api/calendar/oauth/callback

# ---------- apple / icloud calendar (CalDAV) ----------
# Apple ID (email)
ICLOUD_USERNAME=
# пароль приложения: appleid.apple.com → Вход и безопасность → Пароли приложений
ICLOUD_APP_PASSWORD=

# ---------- yougile ----------
# ключ API v2 (Настройки компании → API)
YOUGILE_API_KEY=

# ---------- forward proxy (docker compose --profile proxy up -d) ----------
# логин/пароль для HTTP (8118), SOCKS5 (1080) и HTTPS (8443) прокси
PROXY_USER=proxy
PROXY_PASS=
